# Your self-hosted LiveKit server (from docker-compose.yml).
# Use ws:// for local plain HTTP; wss:// only if you've put TLS in front of it.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret666666666666666666666666

# Used by rag.py for answer generation, and by voice_agent.py for
# Gemini Live speech in/out (the voice agent reuses this as GOOGLE_API_KEY
# automatically — you don't need to set both).
GEMINI_API_KEY=your_gemini_key_here
